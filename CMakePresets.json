{
    "version": 8,
    "configurePresets": [
        {
            "name": "gcc16",
            "displayName": "GCC 16.2.1 x86_64-pc-linux-gnu",
            "description": "正在使用编译器: C = /usr/sbin/gcc, CXX = /usr/sbin/g++",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/sbin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/sbin/g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc16-noexc",
            "displayName": "GCC 16.2.1 x86_64-pc-linux-gnu (无异常)",
            "description": "以 YLOG_NO_EXCEPTIONS=ON 构建，只运行 noexc 自检",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/sbin/gcc",
                "CMAKE_CXX_COMPILER": "/usr/sbin/g++",
                "CMAKE_BUILD_TYPE": "Debug",
                "YLOG_NO_EXCEPTIONS": "ON"
            }
        },
        {
            "name": "gcc16-cov",
            "displayName": "GCC 16.2.1 (覆盖率插桩)",
            "description": "以 --coverage 构建供 gcovr 统计 src/ 覆盖率；不指定安装前缀，也不编无异常变体——同一份源码两份计数混在一起会让数字失去意义",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS": "--coverage",
                "CMAKE_EXE_LINKER_FLAGS": "--coverage",
                "YLOG_BUILD_NOEXC_TESTS": "OFF"
            }
        },
        {
            "name": "clang",
            "displayName": "Clang 23.1.5 (供 clangd 使用)",
            "description": "只服务 clangd：clang 23 无 P2996 反射，无法构建本库（见 issue #43）。生成编译数据库与模块 BMI；clangd 版本须与 clang 一致",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "/usr/sbin/clang",
                "CMAKE_CXX_COMPILER": "/usr/sbin/clang++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc16",
            "configurePreset": "gcc16"
        },
        {
            "name": "gcc16-noexc",
            "configurePreset": "gcc16-noexc"
        },
        {
            "name": "gcc16-cov",
            "configurePreset": "gcc16-cov"
        }
    ]
}